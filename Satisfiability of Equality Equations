class Solution:
    def equationsPossible(self, equations: List[str]) -> bool:
        parent = list(range(26))

        def find(x):
            if parent[x] != x:
                parent[x] = find(parent[x])
            return parent[x]

        def union(a, b):
            pa = find(ord(a) - ord('a'))
            pb = find(ord(b) - ord('a'))
            parent[pa] = pb

        for eq in equations:
            if eq[1] == '=':
                union(eq[0], eq[3])

        for eq in equations:
            if eq[1] == '!':
                if find(ord(eq[0]) - ord('a')) == find(ord(eq[3]) - ord('a')):
                    return False

        return True
